{
  "name": "Taro-templae",
  "version": "1.0.0",
  "private": true,
  "description": "Taro React TypeScript multi-platform template",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/patch-nutui-fixednav.js && node scripts/patch-nutui-signature.js && node scripts/patch-nutui-use-ref-state.js && node scripts/patch-antd-portal.js && node scripts/patch-nutui-icon-tag.js",
    "new": "taro new",
    "build:weapp": "taro build --type weapp && node scripts/build-version.js weapp production",
    "build:swan": "taro build --type swan && node scripts/build-version.js swan production",
    "build:alipay": "taro build --type alipay && node scripts/build-version.js alipay production",
    "build:tt": "taro build --type tt && node scripts/build-version.js tt production",
    "build:h5": "taro build --type h5 && node scripts/build-version.js h5 production",
    "build:rn": "taro build --type rn && node scripts/build-version.js rn production",
    "build:rn:android": "taro build --type rn --platform android",
    "build:rn:ios": "taro build --type rn --platform ios",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1",
    "release:android": "powershell -ExecutionPolicy Bypass -File scripts/release-android.ps1",
    "build:qq": "taro build --type qq && node scripts/build-version.js qq production",
    "build:jd": "taro build --type jd && node scripts/build-version.js jd production",
    "build:harmony-hybrid": "taro build --type harmony-hybrid && node scripts/build-version.js harmony-hybrid production",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:swan": "taro build --type swan --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "dev:tt": "taro build --type tt --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:rn": "taro build --type rn --watch",
    "dev:rn:android": "taro build --type rn --platform android --watch",
    "dev:rn:ios": "taro build --type rn --platform ios --watch",
    "dev:rn:qr": "taro build --type rn --watch --qr",
    "dev:qq": "taro build --type qq --watch",
    "dev:jd": "taro build --type jd --watch",
    "dev:harmony-hybrid": "taro build --type harmony-hybrid --watch"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "yanzx",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@bam.tech/react-native-image-resizer": "^3.0.10",
    "@nutui/nutui-react-taro": "^3.0.20",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-camera-roll/camera-roll": "^7.8.3",
    "@react-native-clipboard/clipboard": "^1.14.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.1.0",
    "@react-native-community/slider": "^4.4.2",
    "@react-native-picker/picker": "^2.6.1",
    "@tarojs/components": "4.2.1",
    "@tarojs/components-rn": "^4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-harmony-hybrid": "4.2.1",
    "@tarojs/plugin-platform-jd": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/router-rn": "^4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/taro-rn": "^4.2.1",
    "expo": "~50.0.0",
    "expo-av": "~13.10.6",
    "expo-barcode-scanner": "~12.9.3",
    "expo-brightness": "~11.8.0",
    "expo-camera": "~14.1.3",
    "expo-file-system": "~16.0.9",
    "expo-image-picker": "~14.7.1",
    "expo-keep-awake": "~12.8.2",
    "expo-location": "~16.5.5",
    "expo-sensors": "~12.9.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-native": "^0.73.11",
    "react-native-device-info": "^14.0.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-pager-view": "^6.2.3",
    "react-native-root-siblings": "^5.0.1",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-webview": "^13.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@react-native/metro-config": "^0.73.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-generator": "4.2.1",
    "@tarojs/rn-runner": "^4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/minimatch": "^5",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "metro-react-native-babel-preset": "^0.77.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
